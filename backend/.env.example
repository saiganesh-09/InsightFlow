# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://insightflow:insightflow@localhost:5432/insightflow"

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Set to "true" to run without Redis (cache/rate-limit/jobs degrade gracefully
# to in-memory/disabled). Intended only for local development.
ALLOW_NO_REDIS=false

# ── Auth / JWT ──────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# ── CORS / URLs ─────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# ── AI (OpenAI-compatible) ──────────────────────────────────────────────
# Any OpenAI-compatible endpoint works (OpenAI, Azure-compatible proxies,
# OpenRouter, Ollama /v1, etc.)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_INGEST_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20

# ── Seed demo credentials (used by prisma/seed.ts) ──────────────────────
SEED_ADMIN_EMAIL="admin@insightflow.dev"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_DEMO_EMAIL="demo@insightflow.dev"
SEED_DEMO_PASSWORD="Demo123!"
